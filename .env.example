# ==============================================================================
# SecuritySTEX Environment Configuration
# ==============================================================================

# Web Application Base URL (Used by Discord bot to generate verification links)
# For local development: http://localhost:3000
# For production: https://verify.yourdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Your Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL="https://eefnbsrplexrylppjlek.supabase.co"

# Supabase Public Anon Key (for public client-side operations)
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_RM3GU2MVU-pnfUfD5PJmFg_uz9u_wvq"

# Supabase Service Role Key (REQUIRED for server-side verification API to bypass RLS)
# Find this in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# ------------------------------------------------------------------------------
# ProxyCheck.io Anti-VPN / Proxy API
# ------------------------------------------------------------------------------
# Get your free API key at: https://proxycheck.io
# Allows 1,000 queries per day on the free tier
PROXYCHECK_API_KEY="your-proxycheck-api-key-here"

# ------------------------------------------------------------------------------
# Discord Bot & REST API Configuration
# ------------------------------------------------------------------------------
# Bot Token from Discord Developer Portal -> Bot -> Token
DISCORD_BOT_TOKEN="your-discord-bot-token-here"

# Bot Application / Client ID from Discord Developer Portal -> General Information
DISCORD_CLIENT_ID="your-discord-client-id-here"

# Target Discord Server (Guild) ID where members will be verified
DISCORD_GUILD_ID="your-discord-guild-id-here"

# Role ID to assign when verification is successful
DISCORD_VERIFIED_ROLE_ID="your-discord-verified-role-id-here"

# (Optional) Role ID to remove once verified (e.g. "Unverified" or "Quarantined" role)
DISCORD_UNVERIFIED_ROLE_ID="your-discord-unverified-role-id-here"

# ------------------------------------------------------------------------------
# Audit Webhook Logging
# ------------------------------------------------------------------------------
# Discord Webhook URL for posting rich verification audit logs
# (Includes username, user ID, account creation date, plain-text IP, and timestamp)
DISCORD_LOG_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
